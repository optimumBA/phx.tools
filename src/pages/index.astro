---
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import AgentMetadata from '../components/AgentMetadata.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phx.tools</title>
    <link rel="canonical" href="https://phx.tools/" />

    <!-- SEO / Open Graph -->
    <meta
      name="description"
      content="Phx.tools is a shell script for Linux and macOS that configures the development environment for you in a few easy steps. Once you finish running the script, you'll be able to create a new Phoenix application and launch the server."
    />
    <meta name="keywords" content="elixir, erlang, homebrew, mise, phoenix" />
    <meta
      property="og:title"
      content="The Complete Development Environment for Elixir and Phoenix"
    />
    <meta
      property="og:description"
      content="Phx.tools is a shell script for Linux and macOS that configures the development environment for you in a few easy steps. Once you finish running the script, you'll be able to create a new Phoenix application and launch the server."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://phx.tools" />
    <meta
      property="og:image"
      content="https://phx.tools/images/phx_tools.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="The Complete Development Environment for Elixir and Phoenix"
    />
    <meta
      name="twitter:description"
      content="Phx.tools is a shell script for Linux and macOS that configures the development environment for you in a few easy steps. Once you finish running the script, you'll be able to create a new Phoenix application and launch the server."
    />
    <meta
      name="twitter:image"
      content="https://phx.tools/images/phx_tools.png"
    />
    <meta name="twitter:site" content="@optimumBA" />
    <meta name="twitter:url" content="https://phx.tools" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon-16x16.png"
    />
    <link rel="apple-touch-icon" href="/images/favicon-180x180.png" />

    <!-- Styles -->
    <link rel="stylesheet" href="/css/app.css" />

    <!-- Plausible analytics -->
    <script is:inline>
      if (window.location.hostname === 'phx.tools') {
        window.plausible = window.plausible || function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
        window.plausible.init = window.plausible.init || function (options) {
          window.plausible.o = options || {};
        };
        window.plausible.init();
        const analytics = document.createElement('script');
        analytics.async = true;
        analytics.src = 'https://plausible.io/js/pa-XKrUX2y1aDt7zs1JUFagg.js';
        document.head.appendChild(analytics);
      }
    </script>

    <!-- Asciinema preconnect -->
    <link rel="preconnect" href="https://asciinema.org/" />
  <AgentMetadata /></head>

  <body class="bg-[#110A33] mx-auto sm:px-2 md:px-7 lg:w-9/12 sm:py-8">
    <div class="min-h-screen" role="main">
      <div class="mt-[5%] md:flex flex-col items-center max-w-4xl mx-auto">
        <!-- Logo + Tagline -->
        <div class="sm:flex flex-col justify-center items-center">
          <Logo />
          <h1
            class="sm:py-6 text-center text-white text-sm md:text-base lg:text-lg font-martian font-semibold"
          >
            The Complete Development Environment for Elixir and Phoenix
          </h1>
        </div>

        <!-- Install command box + instructions -->
        <div
          class="md:flex lg:w-[75%] flex-col relative md:mb-2 w-full"
          style="overflow: visible"
        >
          <div class="md:flex">
            <!-- Info icon (shown on md+) -->
            <div
              class="flex justify-end items-center md:order-last md:mx-2 sm:mb-2"
            >
              <button
                id="info-btn"
                class="hidden md:block w-6 h-6 text-white cursor-pointer focus:text-gray-400"
                aria-label="Show installation instructions"
                onclick="toggleInstructions()"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-6 h-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"
                  />
                </svg>
              </button>
            </div>

            <!-- Command box -->
            <div
              class="border sm:px-3 bg-[#26168780] w-full flex items-center justify-center py-2 sm:space-x-3 rounded-sm overflow-x-auto whitespace-nowrap no-scrollbar"
            >
              <h2
                id="tool-installation"
                class="text-center text-white font-martian sm:text-sm"
              >
                $SHELL -c "$(curl -fsSL https://phx.tools)"
              </h2>
              <div
                id="copy-btn"
                class="sm:py-3 md:my-0 cursor-pointer ml-3 flex-shrink-0"
                onclick="copyCommand()"
              >
                <!-- Copied icon (hidden by default) -->
                <svg
                  id="copied-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  class="icon icon-tabler icon-tabler-circle-check hidden"
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  stroke-width="1.5"
                  stroke="white"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                  <path d="M9 12l2 2l4 -4" />
                </svg>
                <!-- Copy icon (shown by default) -->
                <svg
                  id="copy-icon"
                  width="24"
                  height="24"
                  viewBox="0 0 18 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M5 3H3C1.89543 3 1 3.89543 1 5V17C1 18.1046 1.89543 19 3 19H13C14.1046 19 15 18.1046 15 17V16M5 3C5 4.10457 5.89543 5 7 5H9C10.1046 5 11 4.10457 11 3M5 3C5 1.89543 5.89543 1 7 1H9C10.1046 1 11 1.89543 11 3M11 3H13C14.1046 3 15 3.89543 15 5V8M17 12H7M7 12L10 9M7 12L10 15"
                    stroke="white"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
            </div>
          </div>

          <!-- Instructions wrapper: zero-height flow anchor for the absolute panel -->
          <div class="w-full h-0 overflow-visible flex justify-center">
            <div
              id="installation-instructions"
              class="hidden font-normal font-martian bg-[#110A33] absolute w-full md:w-[95%] z-10"
            >
              <div class="block">
                <div
                  class="h-full rounded-md pb-2"
                  style="box-shadow: 0 4px 10px rgba(194, 184, 255, 0.5)"
                >
                  <div
                    class="text-start px-[3%] lg:text-xl md:text-lg sm:text-md"
                  >
                    <h1
                      id="instructions-title"
                      class="text-white text-center text-sm md:text-base lg:text-lg lg:my-[5%] md:my-[2%] sm:my-[2%] lg:pt-5"
                    >
                      <!-- Filled by JS -->
                    </h1>
                    <ol
                      id="instructions-list"
                      class="list-decimal ml-3 pl-5 text-xs md:text-sm lg:text-base text-white lg:mt-4 sm:mt-2 leading-6"
                    >
                      <!-- Filled by JS -->
                    </ol>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Source code button -->
          <div class="justify-center gap-4 mt-2 flex">
            <div class="sm:grid grid gap-4 sm:py-4">
              <div
                class="border-2 border-[#755FFF] py-4 rounded-xl cursor-pointer hover:bg-indigo-850 flex font-martian w-44"
              >
                <a
                  href="https://github.com/optimumBA/phx.tools/blob/main/static/script.sh"
                  target="_blank"
                  class="flex items-center justify-center w-full space-x-2 text-sm rounded-xl"
                >
                  <!-- Code bracket icon -->
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-5 h-5 text-white"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"
                    />
                  </svg>
                  <span class="text-white text-sm md:text-base"
                    >Source code</span
                  >
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Lower content section -->
        <div class="lg:w-[1100px] w-full">
          <div class="w-[100%] flex flex-col gap-8 items-center justify-center">
            <!-- Description -->
            <div class="md:w-[65%]">
              <p
                class="text-responsive text-mono px-2 leading-5 text-center md:leading-6"
              >
                Phx.tools is a shell script for Linux and macOS that configures
                the development environment for you in a few easy steps. Once
                you finish running the script, you'll be able to create a new
                Phoenix application and launch the server.
              </p>
            </div>

            <!-- Unsupported OS warning (shown by JS for non-Linux/macOS) -->
            <div
              id="unsupported-os"
              class="hidden md:w-[61%] mb-6 bg-[#110A33] rounded-[4px] shadow-lg text-white shadow-[#2C2650] max-w-[809px]"
            >
              <div
                class="bg-[#2C2650] p-3 rounded-t-[4px] flex sm:flex-col md:flex-row sm:items-start md:items-center sm:space-y-2 md:space-y-0 md:space-x-4 sm:justify-start md:justify-center"
              >
                <div class="w-full md:w-auto flex justify-center items-center">
                  <svg
                    width="22"
                    height="22"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
                <p
                  class="font-martian text-center sm:text-sm md:text-base lg:text-lg md:py-2"
                >
                  Unsupported Operating System Detected
                </p>
              </div>
              <p
                class="text-responsive text-mono leading-5 md:leading-6 text-center sm:px-3 sm:py-6 md:px-8"
              >
                It looks like you're using an operating system that Phx.tools
                doesn't currently support. This script is designed to work on
                Linux and macOS only. Please switch to a compatible operating
                system to continue.
              </p>
            </div>
          </div>

          <!-- Asciinema embed container (filled by JS) -->
          <div id="asciinema-container" class="mx-auto"></div>

          <!-- Web updates link -->
          <p
            class="text-responsive text-mono text-center md:px-12 leading-6 sm:pb-4"
          >
            Read about website updates here -
            <a
              href="https://optimum.ba/blog/exciting-updates-to-phx-tools"
              target="_blank"
              class="text-[#24B2FF] underline"
            >
              https://optimum.ba/blog/exciting-updates-to-phx-tools
            </a>
          </p>
        </div>
      </div>
    </div>

    <Footer />

    <script is:inline>
      // OS detection
      var ua = navigator.userAgent;
      var isMac = /Mac|iPhone|iPad/.test(ua);
      var isLinux = /Linux/.test(ua) && !/Android/.test(ua);
      var osType = isMac ? "macos" : isLinux ? "linux" : "other";

      // Installation instructions data
      var macInstructions = [
        "Click on the copy icon to copy this command to your clipboard",
        'Open Terminal by pressing <b class="font-extrabold">\u2318 + SPACE</b> together',
        'Type "Terminal" and hit <b>RETURN</b>',
        "Paste the shell command by hitting <b>\u2318 + V</b> together",
        "Run the command by hitting <b>RETURN</b>",
      ];
      var linuxInstructions = [
        "Click on the copy icon to copy this command to your clipboard",
        'Open Terminal by pressing <b class="font-extrabold">Ctrl + Alt + T</b> together',
        "Paste the shell command by pressing <b>Shift + Ctrl + V</b> together",
        "Run the command by hitting <b>ENTER</b>",
      ];

      // Set instructions title text
      var instructionsTitle = document.getElementById("instructions-title");
      instructionsTitle.textContent =
        (osType === "macos" ? "macOS" : "Linux") + " installation process";

      // Populate instructions list
      var instructionsList = document.getElementById("instructions-list");
      var instructions =
        osType === "macos" ? macInstructions : linuxInstructions;
      instructions.forEach(function (item) {
        var li = document.createElement("li");
        li.className = "mb-2";
        li.innerHTML = item;
        instructionsList.appendChild(li);
      });

      // Show/hide unsupported OS warning
      if (osType === "other") {
        document.getElementById("unsupported-os").classList.remove("hidden");
      }

      // Load Asciinema only for supported OS
      if (osType !== "other") {
        var castId = osType === "macos" ? "689829" : "689816";
        var container = document.getElementById("asciinema-container");
        // Match the embedded 80×24 terminal's native font metrics before it loads.
        // The player uses 0.75em borders, a 32px control bar and a 24px credit.
        var metrics = document.createElement('span');
        metrics.style.cssText = 'position:absolute;visibility:hidden;font:15px "Cascadia Code","Source Code Pro",Menlo,Consolas,"DejaVu Sans Mono",monospace;width:80ch;height:33.5em;box-sizing:content-box;padding:0 0.75em';
        document.body.appendChild(metrics);
        var terminalRatio = metrics.getBoundingClientRect().height / metrics.getBoundingClientRect().width;
        metrics.remove();
        container.style.marginBlock = '1.5em';
        var playerWidth;
        function reservePlayerSpace() {
          if (playerWidth === container.clientWidth) return;
          playerWidth = container.clientWidth;
          container.style.minHeight = Math.round(playerWidth * terminalRatio + 56) + 'px';
        }
        reservePlayerSpace();
        new ResizeObserver(reservePlayerSpace).observe(container);
        window.addEventListener('message', function (event) {
          var iframe = container.querySelector('iframe');
          if (event.origin === 'https://asciinema.org' && iframe && event.source === iframe.contentWindow && event.data?.type === 'bodySize' && Number.isFinite(event.data.payload?.height) && event.data.payload.height > 0) {
            container.style.minHeight = event.data.payload.height + 'px';
          }
        });

        var script = document.createElement("script");
        script.src = "https://asciinema.org/a/" + castId + ".js";
        script.id = "asciicast-" + castId;
        container.appendChild(script);
      }

      // Auto-scroll command box to the right on load (matches original ScrollingHooks)
      var toolInstallationElement =
        document.getElementById("tool-installation");
      if (toolInstallationElement) {
        toolInstallationElement.scrollLeft =
          toolInstallationElement.scrollWidth;
      }

      // Copy command to clipboard
      function copyCommand() {
        var command = document.getElementById("tool-installation").innerText;
        var copyIcon = document.getElementById("copy-icon");
        var copiedIcon = document.getElementById("copied-icon");

        function showCopied() {
          copyIcon.classList.add("hidden");
          copiedIcon.classList.remove("hidden");
          setTimeout(function () {
            copiedIcon.classList.add("hidden");
            copyIcon.classList.remove("hidden");
          }, 600);
        }

        navigator.clipboard
          .writeText(command)
          .then(showCopied)
          .catch(function () {
            var textarea = document.createElement("textarea");
            textarea.value = command;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);
            showCopied();
          });
      }

      // Toggle installation instructions panel
      function toggleInstructions() {
        var panel = document.getElementById("installation-instructions");
        panel.classList.toggle("hidden");
      }

      // Close instructions when clicking outside
      document.addEventListener("click", function (event) {
        var panel = document.getElementById("installation-instructions");
        var btn = document.getElementById("info-btn");
        if (
          !panel.classList.contains("hidden") &&
          !panel.contains(event.target) &&
          event.target !== btn &&
          !btn.contains(event.target)
        ) {
          panel.classList.add("hidden");
        }
      });
    </script>
  </body>
</html>
